---
import Section from "@/components/Section.astro"
import { formatCvDate } from "@/i18n/formatCvDate"
import { cvLabels } from "@/i18n/ui"

type WorkMode = "remote" | "hybrid" | "on-site"

interface WorkExperience {
  name: string
  startDate: string
  endDate: string | null
  position: string
  workMode?: WorkMode
  technologies?: string[]
  summary: string
  url: string
}

const { work }: { work: WorkExperience[] } = Astro.props.cv
const currentLanguage = (Astro.currentLocale ?? "en") as "en" | "es"
const labels = cvLabels[currentLanguage]
---

<Section title="experience">
  <ul>
    {
      work.map(
        ({
          name,
          startDate,
          endDate,
          position,
          workMode,
          technologies,
          summary,
          url,
        }) => {
        const start = formatCvDate(startDate, currentLanguage)
        const end = endDate
          ? formatCvDate(endDate, currentLanguage)
          : labels.present
        const dates = `${start} - ${end}`
        const hasTechnologies = (technologies?.length ?? 0) > 0
        return (
          <li>
            <article data-print-item="experience">
              <header>
                <h3>
                  <a
                    href={url}
                    title={name}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {name}
                  </a>
                </h3>
                <time>{dates}</time>
                <p class="position">{position}</p>
              </header>
              <footer>
                <p class="summary">{summary}</p>
                {(workMode || hasTechnologies) && (
                  <p class="meta">
                    {workMode && (
                      <span class="tag" data-work-mode={workMode}>
                        {labels.workModes[workMode]}
                      </span>
                    )}
                    {technologies?.map((technology) => (
                      <span class="tag">{technology}</span>
                    ))}
                  </p>
                )}
              </footer>
            </article>
          </li>
        )
      })
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  article h3 {
    grid-area: company;
    min-width: 0;
    font-weight: 500;
    color: var(--text-heading);
  }

  article a {
    color: var(--text-heading);
  }

  article a:hover {
    text-decoration: underline;
  }

  article h4 {
    color: var(--text-heading);
    font-weight: 400;
  }

  article {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr) max-content;
    grid-template-areas:
      "company meta dates"
      "position position position"
      "summary summary summary";
    column-gap: 8px;
    align-items: baseline;
  }

  article > header,
  article > footer {
    display: contents;
  }

  .position {
    grid-area: position;
  }

  .summary {
    grid-area: summary;
  }

  .meta {
    grid-area: meta;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 0;
  }

  .tag {
    border-radius: 6px;
    background: var(--surface);
    color: var(--tag-text);
    padding: 1px 6px;
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
  }

  time {
    grid-area: dates;
    color: var(--text-muted);
    font-size: 0.85rem;
    white-space: nowrap;
    cursor: default;
    text-align: right;
  }

  [data-title]:hover:after {
    opacity: 1;
    transition: all 0.1s ease-in-out 0.5s;
    visibility: visible;
  }

  [data-title]:after {
    content: attr(data-title);
    background-color: #333;
    color: #fff;
    font-size: 0.75rem;
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      "Courier New",
      monospace;
    position: absolute;
    padding: 0.2rem 0.5rem;
    bottom: -1.4rem;
    left: 50%;
    white-space: nowrap;
    box-shadow: 1px 1px 1px #222222;
    opacity: 0;
    border: 1px solid #111111;
    z-index: 99999;
    visibility: hidden;
    border-radius: 6px;
  }

  [data-title] {
    position: relative;
  }

  @media screen and (width <= 700px) {
    article {
      grid-template-columns: minmax(0, 1fr) max-content;
      grid-template-areas:
        "company dates"
        "position position"
        "summary summary"
        "meta meta";
    }

    .meta {
      margin-top: 4px;
    }
  }

  @media print {
    ul {
      display: block;
    }

    li + li {
      margin-top: 14pt;
    }

    article {
      grid-template-columns: max-content minmax(0, 1fr) max-content;
      grid-template-areas:
        "company meta dates"
        "position position position"
        "summary summary summary";
      break-inside: avoid-page;
      page-break-inside: avoid;
    }

    article h3 {
      font-size: 10.5pt;
      line-height: 1.2;
    }

    article header p,
    article footer p {
      font-size: 9pt;
      line-height: 1.38;
    }

    time {
      font-size: 8.25pt;
      line-height: 1.35;
      text-align: right;
    }

    .meta {
      gap: 1.5pt 4pt;
      color: #333;
    }

    .tag {
      border-radius: 2pt;
      padding: 0.5pt 3pt;
      font-size: 7.5pt;
      line-height: 1.3;
    }
  }
</style>
